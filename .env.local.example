# ──────────────────────────────────────────────────────────────────
# TUKOLA — environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────────

# Supabase project URL (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe to expose client-side — limited RLS permissions)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase service role key — SERVER SIDE ONLY, never prefix with NEXT_PUBLIC_
# Find it in: Supabase Dashboard → Project Settings → API → service_role key
# Used by all /api/* routes to bypass RLS safely
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin portal PIN — change this before deploying to production!
# Default if not set: tukola2025
ADMIN_PIN=tukola2025
