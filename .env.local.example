# ──────────────────────────────────────────────────────────────────
# TUKOLA — environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────────

# Supabase project URL (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe to expose client-side — limited RLS permissions)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase service role key — SERVER SIDE ONLY, never prefix with NEXT_PUBLIC_
# Find it in: Supabase Dashboard → Project Settings → API → service_role key
# Used by all /api/* routes to bypass RLS safely
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin portal PIN — REQUIRED, no default. Set a strong, unique value.
# Never reuse anything previously committed to this repo.
ADMIN_PIN=replace-with-a-strong-unique-pin

# Secret used to sign the admin session cookie (kola_admin) — REQUIRED.
# Must be at least 16 characters; use a long random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-64-char-random-hex

# Demo mode — true shows demo jobs/workers in the app (for demos and pitches).
# false or omitted = production: only real data from the database is shown.
NEXT_PUBLIC_DEMO_MODE=false

# Secret used to sign user session cookies (kola_session) — REQUIRED in
# production. Must be at least 16 characters; use a long random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In local development you may omit it (an ephemeral per-boot secret is used).
SESSION_SECRET=replace-with-64-char-random-hex

# SMS OTP provider. 'mock' sends nothing and logs codes server-side
# (the API response includes devCode in non-production builds).
# Production will use a Ugandan aggregator (UGX 25-35/SMS) — see lib/sms/provider.ts.
SMS_PROVIDER=mock
